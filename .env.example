# Copy to .env next to docker-compose.yml -- docker compose loads .env
# automatically for ${VAR} substitution, so these two get picked up by
# cube_dashboard's `environment:` block without exporting them in your
# shell before `docker compose up`.
#
# Both must match your Cube deployment's own secrets exactly (see the
# Configuration table in README.md) -- they're what let this dashboard
# mint valid tokens for cube_api's REST and system APIs.

CUBEJS_API_SECRET=
CUBEJS_PLAYGROUND_AUTH_SECRET=

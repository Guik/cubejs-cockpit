# Copy to .env next to docker-compose.yml -- docker compose loads it
# automatically, both for cube_api's `env_file: .env` and for the
# ${VAR} substitutions in cubejs_cockpit's `environment:` block, so the
# two services always see the exact same secrets.
#
# CUBEJS_API_SECRET and CUBEJS_PLAYGROUND_AUTH_SECRET below are what let
# cubejs-cockpit mint valid tokens for cube_api's REST and system APIs --
# see the Configuration table in README.md. Add whatever other env vars
# your Cube deployment needs (DB driver credentials, etc.) below them;
# cube_api reads this same file.

CUBEJS_API_SECRET=
CUBEJS_PLAYGROUND_AUTH_SECRET=
